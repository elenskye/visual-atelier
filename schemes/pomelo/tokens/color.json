{
  "$note": "Pomelo 的色板，所有颜色都在这一个文件。5 套配色（palettes）每套明暗各一份；shared 各套共用；derive 由别的角色混出来，mix 的第二项占比是 light / dark。规则见 DESIGN.md §2。改色须过 APCA（contrast.json）。",
  "pageRole": "desk",
  "defaultPalette": "blue",
  "roleDefs": {
    "desk": {
      "label": "桌面",
      "use": "桌子的底色"
    },
    "desk-deep": {
      "label": "桌面暗",
      "use": "拖动时的投影区"
    },
    "paper": {
      "label": "纸",
      "use": "模块页的纸"
    },
    "grid": {
      "label": "方格线",
      "use": "方格纸的线，没有方格的配色是透明"
    },
    "card": {
      "label": "卡面",
      "use": "白卡、输入框"
    },
    "line": {
      "label": "细线",
      "use": "纸上的分割、横线"
    },
    "ink": {
      "label": "墨",
      "use": "正文"
    },
    "ink-soft": {
      "label": "淡墨",
      "use": "次要文字"
    },
    "pen": {
      "label": "笔",
      "use": "手画的线条、边框、缝线点、悄悄话"
    },
    "primary": {
      "label": "主色",
      "use": "按钮"
    },
    "on-primary": {
      "label": "主色上的字"
    },
    "selected": {
      "label": "选中",
      "use": "选中底色，跟主色走"
    },
    "marker": {
      "label": "荧光笔",
      "use": "强调的一抹，文字下面"
    },
    "link": {
      "label": "链接"
    },
    "link-pomelo": {
      "label": "柚子链接",
      "use": "链到 Pomelo 里的东西（[[…|字]]），和普通链接分开"
    },
    "danger": {
      "label": "危险",
      "use": "删除和截止"
    },
    "on-danger": {
      "label": "危险上的字"
    },
    "up": {
      "label": "涨",
      "use": "钱涨了"
    },
    "top": {
      "label": "顶栏"
    },
    "on-top": {
      "label": "顶栏上的字"
    },
    "tab": {
      "label": "当前页签"
    },
    "on-tab": {
      "label": "当前页签上的字"
    },
    "art-ink": {
      "label": "贴纸墨线",
      "use": "图形的墨线；钢笔家族用笔色"
    },
    "art-white": {
      "label": "贴纸白边"
    },
    "art-shadow": {
      "label": "贴纸投影"
    },
    "shadow": {
      "label": "投影",
      "use": "卡片、纸的投影色"
    }
  },
