{
  "$note": "动效的数值，取自站主验收的 Phase 2 小样；规则见 DESIGN.md §5。每个零件照这里取，招牌时刻要登记在 registeredSurfaces；零件在 motion/（Dawn Plan · Phase 5）。",
  "easing": {
    "spring": "cubic-bezier(.3,1.6,.5,1)",
    "spring-soft": "cubic-bezier(.3,1.5,.5,1)",
    "sheet": "cubic-bezier(.25,1.2,.5,1)",
    "flip": "cubic-bezier(.35,.1,.2,1)",
    "fall": "cubic-bezier(.5,0,.7,.4)",
    "bloom": "cubic-bezier(.2,.9,.3,1.12)"
  },
  "tiers": {
    "calm": {
      "use": "控件的小动静：每个控件碰一下都有回应，服务状态反馈。正在读的长文本身不动。",
      "stateMs": [
        80,
        380
      ],
      "enterMs": 450,
      "enterEasing": "spring",
      "maxMsWithoutSignature": 600,
      "forbid": [
        "parallax",
        "loop",
        "page-transition"
      ]
    },
    "expressive": {
      "use": "招牌时刻和柚子的表情，要登记。",
      "maxSingleMs": 3000,
      "registeredSurfacesOnly": true,
      "loopRules": "只有柚子的表情和等待时的动画能循环；减弱动态效果时停下",
      "registeredSurfaces": [
        "greeting",
        "wheel-open",
        "pomelo-think",
        "pomelo-answer",
        "pomelo-idle",
        "pomelo-sleepy",
        "pomelo-face",
        "atlas-envelope",
        "atlas-turn",
        "done-cheer",
        "empty-state",
        "loading-needle",
        "easter-egg"
      ]
    }
  },
  "personalities": {
    "jelly": {
      "label": "果冻弹",
      "use": "完成、勾选、按下、贴纸啪地贴上",
      "easing": "spring",
      "pressMs": 80,
      "pressScale": 0.9,
      "releaseMs": 380,
      "slapMs": [
        450,
        550
      ]
    },
    "drawThenBounce": {
      "label": "画完再弹",
      "use": "等待（柚子在想）、出现（空状态、新卡片、每一幕）",
      "strokeMs": [
        500,
        1000
      ],
      "strokeEasing": "ease-out",
      "fillMs": 400,
      "popMs": 500,
      "popEasing": "spring",
      "staggerMs": [
        70,
        300
      ]
    },
    "paperPhysics": {
      "label": "纸的物理",
      "use": "拖动、甩、撕、翻、打印",
      "inertiaPerFrame": 0.92,
      "wheelInertiaPerFrame": 0.95,
      "flipMs": 800,
      "flipEasing": "flip",
      "fallMs": 600,
      "fallEasing": "fall"
    }
  },
  "registeredSurfaces": {
    "greeting": {
      "tier": "expressive",
      "label": "打开 App 的问候",
      "personality": "drawThenBounce",
      "trigger": "打开 App",
      "maxMs": 2200,
      "loop": false
    },
    "wheel-open": {
      "tier": "expressive",
      "label": "呼出柚子瓣",
      "personality": "drawThenBounce",
      "trigger": "点左上角的柚子",
      "maxMs": 900,
      "loop": false
    },
    "pomelo-think": {
      "tier": "expressive",
      "label": "柚子在想",
      "personality": "drawThenBounce",
      "trigger": "等柚子回答",
      "loop": true,
      "loopMs": 1600
    },
    "pomelo-answer": {
      "tier": "expressive",
      "label": "柚子回答：一个字一个字写出来",
      "personality": "drawThenBounce",
      "trigger": "柚子想好了",
      "maxMs": 3000,
      "loop": false,
      "charMs": 24
    },
    "pomelo-idle": {
      "tier": "expressive",
      "label": "柚子平常的样子：呼吸两下（一下 2.6 秒）、看一看、眨一下眼",
      "trigger": "一直在",
      "loop": true,
      "loopMs": 5200
    },
    "pomelo-sleepy": {
      "tier": "expressive",
      "label": "柚子睡着了",
      "trigger": "20 秒不动",
      "loop": true,
      "loopMs": 5200
    },
    "pomelo-face": {
      "tier": "expressive",
      "label": "柚子换表情（眨眼、开心、出错、哇、惊讶）",
      "personality": "jelly",
      "trigger": "到桌上、进一页、出错、打开柚子瓣和贴纸簿、被吵醒",
      "maxMs": 1300,
      "loop": false
    },
    "atlas-envelope": {
      "tier": "expressive",
      "label": "拆年度小报的信封",
      "personality": "paperPhysics",
      "trigger": "点信封",
      "maxMs": 3000,
      "loop": false
    },
    "atlas-turn": {
      "tier": "expressive",
      "label": "小报翻页",
      "personality": "paperPhysics",
      "trigger": "按节拍自动翻，或点左右",
      "maxMs": 800,
      "loop": false,
      "beatMs": 800
    },
    "done-cheer": {
      "tier": "expressive",
      "label": "全做完撒小贴纸",
      "personality": "jelly",
      "trigger": "勾完最后一项",
      "maxMs": 1600,
      "loop": false
    },
    "empty-state": {
      "tier": "expressive",
      "label": "空状态",
      "personality": "drawThenBounce",
      "trigger": "打开没有内容的页",
      "maxMs": 2200,
      "loop": false
    },
    "loading-needle": {
      "tier": "expressive",
      "label": "加载 · 穿针",
      "trigger": "等待",
      "loop": true,
      "loopMs": 3200
    },
    "easter-egg": {
      "tier": "expressive",
      "label": "小彩蛋：撕起简报角上的柚子贴纸，底下有句悄悄话",
      "personality": "paperPhysics",
      "trigger": "点或拖简报角上的柚子贴纸",
      "maxMs": 1300,
      "loop": false
    }
  },
  "calmExceptions": {
    "tooltip-swing": {
      "parts": [
        "tooltip"
      ],
      "durationMs": 1100,
      "approved": "站主 2026-11-08 要柚子瓣的小签用 Phase 2「控件的小动静」里的小签动效（挂在线上晃两下停住，1.1 秒）；后面 0.5 秒只是越晃越小"
    }
  }
}
