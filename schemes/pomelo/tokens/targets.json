      "link-pomelo": "--color-link-pomelo",
      "danger": "--color-danger",
      "on-danger": "--color-on-danger",
      "up": "--color-up",
      "top": "--color-top",
      "on-top": "--color-on-top",
      "tab": "--color-tab",
      "on-tab": "--color-on-tab",
