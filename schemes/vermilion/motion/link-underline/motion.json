{
  "id": "link-underline",
  "title": "链接下划线收拢",
  "status": "approved",
  "approved": "站主 2026-11-01 批准（VL1 Phase 6）",
  "tier": "calm",
  "trigger": "悬停 / 键盘聚焦（预览与导出用 .is-playing）",
  "durationMs": 220,
  "reducedMotion": "静态终态：直接变朱红、显示完整下划线并上浮 1px，没有过渡",
  "origin": { "repo": "personal-website", "path": "src/styles/global.css（.text-link、.prose a、.page-intro a 规则）", "importedAt": "2026-11-01" },
  "files": { "css": "link-underline.css", "html": "link-underline.fragment.html" },
  "parity": {
    "siteCss": "src/styles/global.css",
    "siteMarkup": { "fromFragment": true, "replace": [["class=\"va-link\"", "class=\"text-link\""]] },
    "baseCss": "site",
    "host": ".va-link",
    "siteHost": ".text-link",
    "trigger": "hover",
    "times": [0, 20, 40, 80, 120, 160, 200, 220]
  },
  "capture": {
    "host": ".va-link-demo",
    "playClass": "is-playing",
    "playTarget": ".va-link",
    "viewport": [460, 80],
    "scale": 3,
    "padPx": 8,
    "fps": 50,
    "holdStartMs": 400,
    "holdEndMs": 1200,
    "themes": ["light", "dark"],
    "loop": 0
  }
}
