{
  "$note": "Pith 的颜色：两套配色（纸与海是默认，雾与赭），各有明暗。App 里在 设置 › 外观、⌘K 换；画布和 App 默认纸与海（站主 2026-11-23）。值来自 Pith Explore EX8–EX11。珊瑚只当点缀（亮底上 Lc 约 44），不写字。改了跑 npm run qa -- --scheme pith 过 APCA。 最淡的字（text-4）比 EX 里的 faint 深浅各挪了一点点（11-24），好在选中行的淡底上也过 60。",
  "pageRole": "page",
  "textRole": "text",
  "defaultPalette": "paper-sea",
  "roleDefs": {
    "page": {
      "label": "页面底",
      "group": "底和线",
      "use": "整页的底（纸）"
    },
    "surface": {
      "label": "面",
      "group": "底和线",
      "use": "卡片、输入框、表格的面"
    },
    "raised": {
      "label": "浮起的面",
      "group": "底和线",
      "use": "右侧面板、弹层、⌘K"
    },
    "tint": {
      "label": "淡底",
      "group": "底和线",
      "use": "悬停时滑进来的那片纸、选中的行"
    },
    "line": {
      "label": "线",
      "group": "底和线",
      "use": "分隔线、卡片的边（装饰，不查对比）"
    },
    "line-2": {
      "label": "深一点的线",
      "group": "底和线",
      "use": "输入框、按钮的边（装饰，不查对比）"
    },
    "text": {
      "label": "正文",
      "group": "字",
      "use": "正文、标题"
    },
    "text-2": {
      "label": "次正文",
      "group": "字",
      "use": "回答里的次要段落、引文"
    },
    "text-3": {
      "label": "说明",
      "group": "字",
      "use": "说明、提示"
    },
    "text-4": {
      "label": "最淡的字",
      "group": "字",
      "use": "日期、计数、注码"
    },
    "accent": {
      "label": "强调",
      "group": "强调",
      "use": "叶脉、枝桠、发送按钮的底、选中的环"
    },
    "accent-text": {
      "label": "强调的字",
      "group": "强调",
      "use": "链接、编号 [n]、强调色的字"
    },
    "on-accent": {
      "label": "强调上的字",
      "group": "强调",
      "use": "发送按钮、主按钮上的字和图标"
    },
    "second": {
      "label": "第二色",
      "group": "强调",
      "use": "知识库卡片的类型标签、角色头像"
    },
    "coral": {
      "label": "珊瑚",
      "group": "点缀",
      "use": "图标里的芽、种子、+1、悬停最后抵达的点（只点缀，不写字）"
    },
    "gold": {
      "label": "金",
      "group": "点缀",
      "use": "少数小徽章的底（混进页面底用）"
    },
    "app-ink": {
      "label": "App 图标底",
      "group": "App 图标",
      "use": "App 图标的墨色方块（明暗一样）"
    },
    "app-paper": {
      "label": "App 图标纸",
      "group": "App 图标",
      "use": "App 图标上的 Logo"
    },
    "app-coral": {
      "label": "App 图标珊瑚",
      "group": "App 图标",
      "use": "App 图标上的果"
    }
  },
  "palettes": {
