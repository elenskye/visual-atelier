        0
      ],
      "enterMs": 400,
      "enterEasing": "steps",
      "maxMsWithoutSignature": 400,
      "forbid": [
        "loop",
        "parallax",
        "smooth-translate",
        "page-transition"
      ]
    },
    "expressive": {
      "use": "发出、等你、做完、撤销这几个时刻，和在跑、等待时的循环；要登记。",
      "maxSingleMs": 1000,
      "registeredSurfacesOnly": true,
      "loopRules": "只有光标、点阵转圈、进度块、在跑那一步、在跑时的扫描能循环；减弱动态效果时停下",
      "registeredSurfaces": [
        "card-edge",
        "send",
        "scan-once",
        "done-flash",
        "wait-turn",
        "roll",
        "caret",
        "twinkle",
        "head-blink",
        "wave",
        "running",
        "scan-loop"
      ]
    }
  },
  "calm": {
