{
  "$note": "Peck 的语义角色，深浅各一套（第 3 步定值；深色为过 APCA 改过的几处记在 history）。半透明的只有 grid、cyan-scan 两个图案用的，其余都是在模块面上混好的实色。",
  "roles": {
    "page": {
      "label": "页面底",
      "group": "底和线",
      "use": "整页的底，上面是 LED 点阵孔",
      "light": "#F2F4FC",
      "dark": "#050816"
    },
    "grid": {
      "label": "点阵孔",
      "group": "底和线",
      "use": "页面底上 8 格一颗的孔（半透明，只当图案）",
      "light": "rgba(40,50,130,.10)",
      "dark": "rgba(120,140,255,.085)"
    },
    "panel": {
      "label": "模块面",
      "group": "底和线",
      "use": "模块、卡片、菜单的面",
      "light": "#FFFFFF",
      "dark": "#0A0F24"
    },
    "panel-2": {
      "label": "内凹",
      "group": "底和线",
      "use": "输入框、代码块、预览的底",
      "light": "#F5F7FD",
      "dark": "#0F1630"
    },
    "raised": {
      "label": "抬起",
      "group": "底和线",
      "use": "悬停的底、灰标签、计数小块",
      "light": "#E7EBF8",
      "dark": "#172040"
    },
    "line": {
      "label": "模块外框",
      "group": "底和线",
      "use": "模块的外层（装饰，靠面和点阵分开，不查对比）",
      "light": "#DAE0F0",
      "dark": "#1E2850"
    },
    "line-strong": {
      "label": "控件边",
      "group": "底和线",
      "use": "按钮、选项片、分段、开关的边；模块里的点线",
      "light": "#B4BDDB",
      "dark": "#43528B"
    },
    "block-off": {
      "label": "没亮的格",
      "group": "底和线",
      "use": "进度块、点阵勾里没亮的格",
      "light": "#E1E6F5",
      "dark": "#141C3C"
    },
    "text": {
      "label": "正文",
      "group": "字",
      "use": "名字、正文、代码",
      "light": "#0B1030",
      "dark": "#E8ECFF"
    },
    "text-2": {
      "label": "说明",
      "group": "字",
      "use": "说明、次要的话、没选中的标签",
      "light": "#4E567A",
      "dark": "#BEC7F5"
    },
    "text-3": {
      "label": "提示",
      "group": "字",
      "use": "提示小字、时间、占位、模块头右边的话",
      "light": "#646C92",
      "dark": "#9FAADE"
    },
    "cyan": {
      "label": "青块",
      "group": "青",
      "use": "主按钮、选中的分段、开着的开关",
      "light": "#007A94",
      "dark": "#00E5FF"
    },
    "cyan-hover": {
      "label": "青块悬停",
      "group": "青",
      "use": "主按钮、开关在悬停时",
      "light": "#00687E",
      "dark": "#4DEDFF"
    },
    "on-cyan": {
      "label": "青块上的字",
      "group": "青",
      "use": "青块上的字和图标",
      "light": "#FFFFFF",
      "dark": "#02101A"
    },
    "cyan-text": {
      "label": "青字",
      "group": "青",
      "use": "选中、链接、在发生；键盘焦点的点线",
      "light": "#007A94",
      "dark": "#00E5FF"
    },
    "cyan-block": {
      "label": "青格",
      "group": "青",
      "use": "进度块、光标、点阵",
      "light": "#0099B8",
      "dark": "#00E5FF"
    },
    "cyan-line": {
      "label": "青线",
      "group": "青",
      "use": "在跑的模块边；悬停时控件的边",
      "light": "#0099B8",
      "dark": "#048FA7"
    },
    "cyan-soft": {
      "label": "青底",
      "group": "青",
      "use": "选中的行、带上的选项片",
      "light": "#E2F4F8",
      "dark": "#09243A"
    },
    "cyan-scan": {
      "label": "扫描光",
      "group": "青",
      "use": "扫描光带（半透明，叠在任何底上）",
      "light": "rgba(0,153,184,.24)",
      "dark": "rgba(0,229,255,.22)"
    },
    "ok": {
      "label": "完成",
      "group": "状态",
      "use": "完成、通过、新增",
      "light": "#12804C",
      "dark": "#4ADE80"
    },
    "ok-soft": {
      "label": "完成底",
      "group": "状态",
      "use": "通过的状态条",
      "light": "#E3F5EC",
      "dark": "#10242D"
    },
    "warn": {
      "label": "等你",
      "group": "状态",
      "use": "等你批、等你答",
      "light": "#A35E00",
      "dark": "#FFB86B"
    },
    "warn-hover": {
      "label": "琥珀悬停",
      "group": "状态",
      "use": "琥珀按钮在悬停时",
      "light": "#8B5000",
      "dark": "#FFCD97"
    },
    "warn-soft": {
      "label": "等你底",
      "group": "状态",
      "use": "等你的提示条",
      "light": "#FFF3E2",
      "dark": "#23202B"
    },
    "warn-line": {
      "label": "等你的边",
      "group": "状态",
      "use": "等你的模块、卡片的边",
      "light": "#A35E00",
      "dark": "#9D744F"
    },
    "on-warn": {
      "label": "琥珀上的字",
      "group": "状态",
      "use": "琥珀按钮上的字",
      "light": "#FFFFFF",
      "dark": "#02101A"
    },
    "bad": {
      "label": "出错",
      "group": "状态",
      "use": "删除、出错、失败、危险",
      "light": "#E11D48",
      "dark": "#FE9AA4"
    },
    "bad-hover": {
      "label": "红悬停",
      "group": "状态",
      "use": "红底按钮在悬停时",
      "light": "#BF193D",
      "dark": "#FEB8BF"
    },
    "bad-soft": {
      "label": "出错底",
      "group": "状态",
      "use": "失败的状态条",
      "light": "#FFE9EE",
      "dark": "#221D31"
    },
    "bad-line": {
      "label": "出错的边",
      "group": "状态",
      "use": "出错的模块、危险按钮的边",
      "light": "#E11D48",
      "dark": "#A96977"
    },
    "on-bad": {
      "label": "红底上的字",
      "group": "状态",
      "use": "真要删的那一下（红底按钮）上的字",
      "light": "#FFFFFF",
      "dark": "#050816"
    },
    "muse": {
      "label": "Muse",
      "group": "身份",
      "use": "Muse 的色点",
      "light": "#6D4AE8",
      "dark": "#A78BFA"
    },
    "grok": {
      "label": "Grok",
      "group": "身份",
      "use": "Grok 的色点",
      "light": "#A35E00",
      "dark": "#FFB86B"
    },
    "api": {
      "label": "API",
      "group": "身份",
      "use": "API 模型的色点",
      "light": "#2563EB",
      "dark": "#60A5FA"
    }
  },
  "aliases": {
    "focus": "cyan-text"
  }
}
